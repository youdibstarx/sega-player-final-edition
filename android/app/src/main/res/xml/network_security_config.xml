<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Preserve provider HTTP streams; the control panel remains HTTPS-only. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Android 7.0 lacks ISRG Root X1. Scope this official CA to our panel. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">sega.faster4k.xyz</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </domain-config>
</network-security-config>
